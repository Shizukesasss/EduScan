# ─────────────────────────────────────────────────────────────────────────────
# EduScan Backend — Environment Configuration
# Copy this file to .env (never commit .env to git).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# OPTION A: SQLite (default — zero-configuration, local development only)
#   Each developer/laptop gets their own isolated database file.
#   Run `python seed_demo.py` once from the backend/ directory to create it.
DATABASE_URL=sqlite:///./data/eduscan.db

# OPTION B: Centralized PostgreSQL (recommended for shared/production use)
#   All users connect to ONE shared database on a central server.
#   See docs/POSTGRESQL_SETUP.md for full setup instructions.
# DATABASE_URL=postgresql+psycopg2://eduscan_app:CHANGE_ME@<server-ip>:5432/eduscan

# OPTION C: MySQL/MariaDB (also supported)
# DATABASE_URL=mysql+pymysql://eduscan:CHANGE_ME@127.0.0.1:3306/eduscan?charset=utf8mb4

# ── Security ──────────────────────────────────────────────────────────────────
# JWT signing secret — leave blank to auto-generate and store in data/.app_secret
# For centralized deployment, set this to the SAME value on every app server.
EDUSCAN_SECRET_KEY=

# Biometric data encryption key — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# For centralized deployment, set this to the SAME value on every app server.
EDUSCAN_ENCRYPTION_KEY=

# ── Biometric settings ────────────────────────────────────────────────────────
LBPH_THRESHOLD=65
BIOMETRIC_MIN_SAMPLES=15
BIOMETRIC_ENABLED=true

# ── CORS / Allowed origins ────────────────────────────────────────────────────
# Separate multiple origins with commas.
# For LAN access, add the server IP: http://192.168.1.10:5174
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174

# ── SF2 template ──────────────────────────────────────────────────────────────
# Optional: absolute path to your official DepEd SF2 workbook.
# It can also be uploaded through the API (System Setup > SF2 Template).
SF2_TEMPLATE_PATH=

# ── Android SMS Gateway ───────────────────────────────────────────────────────
SMS_GATEWAY_ENABLED=false
SMS_GATEWAY_URL=http://192.168.1.100:8080
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=