# ─────────────────────────────────────────────────────────────────────────────
# EduScan Backend — Environment Configuration
# Copy this file to .env (never commit .env to git).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# OPTION A: SQLite (default — zero-configuration, local development only)
#   Each developer/laptop gets their own isolated database file.
#   Run `python seed_demo.py` once from the backend/ directory to create it.
DATABASE_URL=sqlite:///./data/eduscan.db

# OPTION B: Centralized PostgreSQL (recommended for shared/production use)
#   All users connect to ONE shared database on a central server.
#   See docs/POSTGRESQL_SETUP.md for full setup instructions.
# DATABASE_URL=postgresql+psycopg2://eduscan_app:CHANGE_ME@<server-ip>:5432/eduscan
# Use the restricted runtime login here. Supply EDUSCAN_MIGRATION_DATABASE_URL
# only to offline maintenance commands, or enter it at their hidden prompt.

# OPTION C: MySQL/MariaDB (also supported)
# DATABASE_URL=mysql+pymysql://eduscan:CHANGE_ME@127.0.0.1:3306/eduscan?charset=utf8mb4

# ── Security ──────────────────────────────────────────────────────────────────
# Demo accounts and interactive API docs default to on for SQLite and off for server databases.
# Disable both explicitly for a shared deployment backed by SQLite.
# EDUSCAN_SEED_DEMO_ACCOUNTS=false
# EDUSCAN_ENABLE_API_DOCS=false
# JWT signing secret — leave blank to auto-generate and store in data/.app_secret
# For centralized deployment, set this to the SAME value on every app server.
EDUSCAN_SECRET_KEY=

# Google OAuth "Web application" client ID (public identifier, not a client secret).
# Add each frontend origin to the client's Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# Transition setting: reserve admin/scanner emails before enabling strict mode.
# Set true and restart the API to require DepEd Google sign-in for ALL accounts.
# See docs/DEPED_GOOGLE_LOGIN.md.
EDUSCAN_DEPED_ONLY=false

# Optional EduScan password recovery for accounts already verified by DepEd Google sign-in.
EDUSCAN_DEPED_PASSWORD_RECOVERY=false
SMTP_HOST=
SMTP_PORT=587
# false uses STARTTLS. Set true and use port 465 for implicit TLS.
SMTP_USE_SSL=false
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Biometric data encryption key — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# For centralized deployment, set this to the SAME value on every app server.
EDUSCAN_ENCRYPTION_KEY=

# ── Biometric settings ────────────────────────────────────────────────────────
LBPH_THRESHOLD=65
BIOMETRIC_MIN_SAMPLES=15
BIOMETRIC_ENABLED=true

# Retained storage limits in MiB. The backup limit applies per destination folder.
EDUSCAN_BIOMETRIC_STORAGE_MIB=1024
EDUSCAN_REPORT_STORAGE_MIB=2048
EDUSCAN_BACKUP_STORAGE_MIB=4096

# Sustained API request limits per minute, per client address.
EDUSCAN_CAMERA_REQUESTS_PER_MINUTE=120
EDUSCAN_REPORT_REQUESTS_PER_MINUTE=30
EDUSCAN_BACKUP_REQUESTS_PER_MINUTE=6
EDUSCAN_PASSWORD_SIGN_IN_REQUESTS_PER_MINUTE=30
EDUSCAN_GOOGLE_SIGN_IN_REQUESTS_PER_MINUTE=30
EDUSCAN_RESET_REQUESTS_PER_MINUTE=12
EDUSCAN_RESET_CONFIRMATIONS_PER_MINUTE=30
EDUSCAN_SMS_REQUESTS_PER_MINUTE=20
# Combined outbound SMS send attempts per minute for each API process.
EDUSCAN_SMS_GATEWAY_REQUESTS_PER_MINUTE=30

# ── CORS / Allowed origins ────────────────────────────────────────────────────
# Separate multiple origins with commas.
# The managed Windows launcher uses 127.0.0.1:5175. For a separately hosted
# HTTPS site, add its exact origin here and configure the API host accordingly.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5175,http://localhost:5175

# ── SF2 template ──────────────────────────────────────────────────────────────
# Optional: absolute path to your official DepEd SF2 workbook.
# It can also be uploaded through the API (System Setup > SF2 Template).
SF2_TEMPLATE_PATH=

# ── Android SMS Gateway ───────────────────────────────────────────────────────
SMS_GATEWAY_ENABLED=false
SMS_GATEWAY_URL=http://192.168.1.100:8080
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
