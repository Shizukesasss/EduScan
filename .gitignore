# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Node ────────────────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
.npm-cache/

# ─── Python ──────────────────────────────────────────────────────────────────
**/__pycache__/
*.py[cod]
backend/.venv/

# ─── EduScan secrets & environment ───────────────────────────────────────────
backend/.env
# allow the example file
!backend/.env.example

# ─── EduScan runtime-generated data (NOT committed) ──────────────────────────
backend/data/biometrics/
backend/data/models/
backend/data/exports/
backend/data/backups/
backend/data/pre_restore_*/
backend/data/pending_restore/
backend/data/.app_secret
backend/data/.encryption_key

# ─── EduScan committed data ───────────────────────────────────────────────────
# The seeded demo SQLite database IS committed (backend/data/eduscan.db)
# The official SF2 template IS committed (backend/data/templates/)
# All grading Excel templates IS committed (backend/templates/)

# ─── Ignore test output Excel files ──────────────────────────────────────────
backend/test_export.xlsx
backend/test_formula.xlsx

# ─── Ignore root-level duplicate Excel files ─────────────────────────────────
# (they are maintained inside backend/templates/ for the API)
/*.xlsx
/*.xls

# ─── Editor directories and files ────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Agent scratch directory ──────────────────────────────────────────────────
scratch/